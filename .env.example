# Copie para .env.local (dev) ou configure na hospedagem (produção).

# URL pública do site (mesma forma do domínio: com ou sem www)
NEXT_PUBLIC_SITE_URL=https://www.essenciamind.com.br

# Google Analytics 4 — ID da métrica
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-KW0JF3QMEM

